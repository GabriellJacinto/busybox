#!/bin/sh
echo "Starting init script..."
mount -t proc proc /proc
mkdir -p /sys
mount -t sysfs sysfs /sys
mkdir -p /dev
mount -t devtmpfs none /dev
mkdir -p /hostlogs

if mount -t 9p -o trans=virtio,version=9p2000.L hostlogs /hostlogs 2>/dev/null; then
	export LATENCY_LOG_DIR=/hostlogs
	echo "Latency logs: host share mounted at /hostlogs"
else
	echo "Latency logs: host share unavailable, using guest local logs/"
fi

# Helper: extract a key=value from /proc/cmdline
get_cmdline_param() {
    cat /proc/cmdline | tr ' ' '\n' | grep "^${1}=" | cut -d= -f2-
}

HOST="$(hostname)"
AUTO_SHUTDOWN=0
if [ "$HOST" = "sender" ]; then
	echo "Configuring sender..."
	ifconfig eth0 192.168.1.2 netmask 255.255.255.0 up
	echo "Running sender..."
	/sender
	AUTO_SHUTDOWN=1
elif [ "$HOST" = "receiver" ]; then
	echo "Configuring receiver..."
	ifconfig eth0 192.168.1.3 netmask 255.255.255.0 up
	echo "Running receiver..."
	/receiver
	AUTO_SHUTDOWN=1
elif echo "$HOST" | grep -qE "^vehicle[0-9]+$"; then
	echo "Configuring $HOST..."
	ifconfig eth0 up

	VC_ID=$(get_cmdline_param vc_id)
	VC_TIMEOUT=$(get_cmdline_param vc_timeout)
	VC_QUADRANT=$(get_cmdline_param vc_quadrant)
	VC_QCHANGE_MS=$(get_cmdline_param vc_quadrant_change_ms)
	VC_BASE_PORT=$(get_cmdline_param vc_base_port)
	VC_CHANNEL=$(get_cmdline_param vc_channel)
	VC_SHM_PROC_COUNT=$(get_cmdline_param vc_shm_proc_count)
	VC_SHM_BUFFERS=$(get_cmdline_param vc_shm_buffers)
	VC_SHM_KEY=$(get_cmdline_param vc_shm_key)
	VC_SEM_KEY=$(get_cmdline_param vc_sem_key)
	VC_PERIOD_RADAR=$(get_cmdline_param vc_period_radar)
	VC_PERIOD_LIDAR=$(get_cmdline_param vc_period_lidar)
	VC_PERIOD_GPS=$(get_cmdline_param vc_period_gps)

	: "${VC_ID:=1}"
	: "${VC_TIMEOUT:=0}"
	: "${VC_QUADRANT:=0}"
	: "${VC_QCHANGE_MS:=0}"
	: "${VC_BASE_PORT:=200}"
	: "${VC_CHANNEL:=net}"
	: "${VC_SHM_PROC_COUNT:=3}"
	: "${VC_SHM_BUFFERS:=8}"
	: "${VC_SHM_KEY:=74560}"
	: "${VC_SEM_KEY:=74561}"
	: "${VC_PERIOD_RADAR:=200}"
	: "${VC_PERIOD_LIDAR:=200}"
	: "${VC_PERIOD_GPS:=500}"

	echo "Launching fixed vehicle component processes (mode=both for radar/lidar/gps)"
	PIDS=""

	launch_proc() {
		COMPONENT="$1"
		PORT="$2"
		PERIOD="$3"
		SHM_PROC_ID="$4"

		ARGS="--mode both --channel $VC_CHANNEL --vehicle-id $VC_ID --port $PORT --component $COMPONENT --period-ms $PERIOD --timeout-s $VC_TIMEOUT --quadrant $VC_QUADRANT --quadrant-change-ms $VC_QCHANGE_MS --shm-proc-id $SHM_PROC_ID --shm-proc-count $VC_SHM_PROC_COUNT --shm-buffers $VC_SHM_BUFFERS --shm-key $VC_SHM_KEY --sem-key $VC_SEM_KEY"
		echo "Launching vehicle_component $ARGS"
		setsid cttyhack /vehicle_component $ARGS &
		PIDS="$PIDS $!"
	}

	launch_proc radar $((VC_BASE_PORT + 0)) $VC_PERIOD_RADAR 0
	launch_proc lidar $((VC_BASE_PORT + 1)) $VC_PERIOD_LIDAR 1
	launch_proc gps $((VC_BASE_PORT + 2)) $VC_PERIOD_GPS 2

	for PID in $PIDS; do
		wait "$PID"
	done
	AUTO_SHUTDOWN=1
fi

echo "init script finished"
if [ "$AUTO_SHUTDOWN" = "1" ]; then
	echo "Simulation finished, shutting down VM..."
	sync
	poweroff -f 2>/dev/null || halt -f 2>/dev/null || reboot -f
	sleep 1
fi

setsid cttyhack sh
